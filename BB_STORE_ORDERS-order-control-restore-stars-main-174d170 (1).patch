+  box-shadow: 0 0 0 1px rgba(133, 106, 219, .08), 0 0 18px rgba(96, 87, 211, .10), 0 0 42px rgba(222, 71, 205, .045), inset 0 0 30px rgba(103, 232, 249, .025);
+  transition: border-color .2s ease, box-shadow .2s ease;
+}
+.order-control-room .order-search-drawer:focus-within { border-color: rgba(130, 215, 255, .46) !important; box-shadow: 0 0 0 1px rgba(135, 109, 231, .12), 0 0 24px rgba(103, 232, 249, .10), 0 0 48px rgba(218, 75, 207, .075), inset 0 0 34px rgba(103, 232, 249, .035); }
+.order-control-room .order-search-label { color: #e9ddff; }
+.order-control-room .order-search-label-icon { display: grid; width: 1.65rem; height: 1.65rem; place-items: center; border: 1px solid rgba(103, 232, 249, .3); border-radius: .58rem; background: linear-gradient(145deg, rgba(103, 232, 249, .13), rgba(139, 92, 246, .1)); color: #96f3ff; box-shadow: 0 0 14px rgba(103, 232, 249, .1); }
+.order-control-room .order-search-phone-badge { border: 1px solid rgba(228, 117, 229, .25); border-radius: 999px; padding: .25rem .55rem; background: rgba(179, 75, 219, .08); color: #f0caff; font-size: 9px; letter-spacing: .04em; }
+.order-control-room .order-search-input-shell { position: relative; }
+.order-control-room .order-search-input-icon { position: absolute; z-index: 1; top: 50%; left: 1rem; transform: translateY(-50%); color: #7deafa; filter: drop-shadow(0 0 7px rgba(103, 232, 249, .52)); pointer-events: none; }
+.order-control-room .order-search-input { border-color: rgba(151, 127, 227, .42) !important; padding-left: 2.9rem !important; background: linear-gradient(108deg, rgba(13, 14, 29, .98), rgba(7, 10, 20, .98) 58%, rgba(12, 8, 23, .98)) !important; box-shadow: inset 0 1px 0 rgba(255, 255, 255, .055), 0 0 0 1px rgba(86, 74, 158, .12), 0 8px 26px rgba(0, 0, 0, .24); transition: border-color .18s ease, box-shadow .18s ease, background .18s ease; }
+.order-control-room .order-search-input::placeholder { color: rgba(185, 191, 215, .52); }
+.order-control-room .order-search-input:focus-visible { border-color: rgba(112, 230, 255, .72) !important; outline: none; box-shadow: 0 0 0 3px rgba(103, 232, 249, .10), 0 0 24px rgba(103, 232, 249, .16), 0 0 40px rgba(211, 83, 220, .08), inset 0 1px 0 rgba(255, 255, 255, .06); }
+.order-control-room .order-search-helper { color: rgba(181, 185, 211, .62); }
+.order-control-room .order-search-toggle { border-color: rgba(132, 115, 217, .35); background: linear-gradient(110deg, rgba(96, 64, 165, .16), rgba(35, 151, 181, .08)); color: #d8eaff; box-shadow: 0 0 14px rgba(118, 91, 220, .08); }
+.order-control-room .order-search-toggle:hover:not(:disabled) { border-color: rgba(111, 224, 255, .65); background: linear-gradient(110deg, rgba(124, 74, 205, .22), rgba(34, 180, 205, .14)); color: #f5fdff; box-shadow: 0 0 20px rgba(103, 232, 249, .14), 0 0 26px rgba(214, 81, 213, .08); }
+.order-control-room .order-filter-bar { border-color: rgba(127, 111, 196, .27); background: linear-gradient(145deg, rgba(5, 6, 14, .92), rgba(8, 7, 17, .9)); box-shadow: inset 0 0 24px rgba(103, 232, 249, .025), 0 0 20px rgba(112, 78, 201, .055); }
+.order-control-room .order-filter-fields { align-items: stretch; }
+.order-control-room .filter-field { display: flex; flex: 0 1 11rem; min-width: min(100%, 10rem); flex-direction: column; align-items: stretch; gap: .35rem; border-color: rgba(119, 134, 197, .27); border-radius: .8rem; padding: .55rem .65rem; background: linear-gradient(145deg, rgba(4, 7, 15, .92), rgba(8, 7, 17, .92)); color: #aebed2; font: 600 9px/1.2 'IBM Plex Mono', monospace; }
+.order-control-room .filter-field-date { flex-basis: 11rem; max-width: 12rem; }
+.order-control-room .filter-field-page { flex-basis: 13rem; max-width: 15rem; }
+.order-control-room .filter-field input,
+.order-control-room .filter-field select { width: 100%; min-width: 0; border: 0; background: transparent; color: #e2fbff; font: 500 11px/1.3 'IBM Plex Mono', monospace; }
+.order-control-room .filter-field option { background: #0b0b17; color: #e2fbff; }
+.order-control-room .filter-field:focus-within { border-color: rgba(103, 232, 249, .65); box-shadow: 0 0 0 2px rgba(103, 232, 249, .08), 0 0 16px rgba(103, 232, 249, .13); }
+.order-control-room .order-filter-actions > button { min-height: 2.35rem; border-radius: .75rem; }
+.order-control-room .order-search-result-summary { border-color: rgba(126, 128, 195, .22); background: linear-gradient(105deg, rgba(9, 9, 20, .9), rgba(6, 9, 16, .86)); box-shadow: inset 0 1px 0 rgba(255, 255, 255, .025); }
+.order-control-room .order-search-empty { border-color: rgba(149, 111, 225, .18); background: radial-gradient(ellipse at 50% 0%, rgba(120, 81, 203, .075), transparent 72%), rgba(7, 6, 16, .72); }
+.order-control-room .order-refresh-action { border-color: rgba(103, 232, 249, .28); background: rgba(34, 211, 238, .055); color: #c4f7fc; box-shadow: 0 0 13px rgba(103, 232, 249, .055); }
+.order-control-room .order-refresh-action:hover:not(:disabled) { border-color: rgba(103, 232, 249, .62); background: rgba(34, 211, 238, .12); color: #f0fdff; }
+.order-control-room .order-list-panel,
+.order-control-room .order-detail-card { border-color: rgba(124, 111, 188, .24) !important; background-color: rgba(7, 6, 13, .97) !important; box-shadow: 0 14px 42px rgba(0, 0, 0, .30), 0 0 22px rgba(110, 80, 203, .055), inset 0 0 26px rgba(103, 232, 249, .018) !important; }
+.order-control-room .order-detail-head { border-color: rgba(103, 232, 249, .15) !important; background: linear-gradient(90deg, rgba(5, 10, 16, .98), rgba(12, 8, 22, .97) 58%, rgba(6, 10, 16, .98)) !important; }
+.order-control-room .order-list-card { border-color: rgba(119, 106, 176, .20); background: linear-gradient(132deg, rgba(10, 9, 22, .94), rgba(4, 6, 13, .96)); box-shadow: inset 0 1px 0 rgba(255, 255, 255, .035), 0 8px 20px rgba(0, 0, 0, .19); }
+.order-control-room .order-list-card:hover,
+.order-control-room .order-list-card:focus-visible { border-color: rgba(103, 232, 249, .48); background: linear-gradient(120deg, rgba(18, 24, 37, .9), rgba(19, 10, 30, .9)); box-shadow: 0 0 0 1px rgba(103, 232, 249, .12), 0 0 24px rgba(103, 232, 249, .11), 0 0 28px rgba(176, 84, 231, .07); }
+.order-control-room .order-list-card-selected { border-color: rgba(103, 232, 249, .5) !important; background: linear-gradient(100deg, rgba(34, 211, 238, .09), rgba(112, 80, 207, .10) 55%, rgba(194, 62, 180, .055)) !important; box-shadow: inset 3px 0 #67e8f9, 0 0 0 1px rgba(103, 232, 249, .08), 0 0 22px rgba(103, 232, 249, .10), 0 0 26px rgba(190, 76, 217, .055) !important; }
+.order-control-room .order-list-card-latest::after { background: linear-gradient(90deg, transparent, rgba(103, 232, 249, .27), rgba(167, 139, 250, .11), transparent); }
+.order-control-room .order-parcel-result,
+.order-control-room .order-chat-match { border-color: rgba(142, 118, 216, .27); background: linear-gradient(128deg, rgba(13, 10, 25, .96), rgba(5, 8, 15, .96) 72%, rgba(8, 10, 19, .96)); box-shadow: inset 0 1px 0 rgba(255, 255, 255, .035), 0 8px 22px rgba(0, 0, 0, .2), 0 0 16px rgba(121, 79, 214, .045); transition: border-color .18s ease, box-shadow .18s ease, transform .18s ease; }
+.order-control-room .order-parcel-result:hover,
+.order-control-room .order-chat-match:hover { border-color: rgba(103, 232, 249, .46); box-shadow: 0 0 0 1px rgba(103, 232, 249, .08), 0 0 20px rgba(103, 232, 249, .10), 0 0 28px rgba(209, 72, 207, .06); transform: translateY(-1px); }
+@media (max-width: 640px) {
+  .order-control-room .filter-field,
+  .order-control-room .filter-field-date { flex: 1 1 calc(50% - .5rem); max-width: none; }
+  .order-control-room .filter-field-page { flex: 1 1 100%; max-width: none; }
+  .order-control-room .order-filter-actions { justify-content: stretch; }
+  .order-control-room .order-filter-actions > button { flex: 1 1 8rem; }
+  .order-control-room .order-search-topline { align-items: flex-start; }
+}
+.order-control-room [class*="text-cyan-"] { color: #a9f2fa !important; }
+.order-control-room [class*="border-cyan-"] { border-color: rgba(103, 232, 249, .26) !important; }
+.order-control-room [class*="bg-cyan-"] { background-color: rgba(34, 211, 238, .075) !important; }
+.order-control-room [class*="hover:bg-cyan-"]:hover { background-color: rgba(34, 211, 238, .13) !important; }
+.order-control-room [class*="hover:border-cyan-"]:hover { border-color: rgba(103, 232, 249, .62) !important; }
+.order-control-room [class*="to-cyan-"] { --tw-gradient-to: rgba(34, 211, 238, .08) !important; }
+.order-control-room [class*="from-cyan-"] { --tw-gradient-from: rgba(34, 211, 238, .08) !important; --tw-gradient-to: rgb(34 211 238 / 0) !important; }
+.order-control-room [class*="via-cyan-"] { --tw-gradient-via: rgba(34, 211, 238, .07) !important; }
+.order-control-room .order-manual-bridge:hover { border-color: rgba(103, 232, 249, .44); color: #effdff; background: rgba(103, 232, 249, .08); box-shadow: 0 0 15px rgba(103, 232, 249, .08); }
+
+.order-manual-bridge {
+  display: inline-flex;
+  align-items: center;
+  gap: .4rem;
+  border: 1px solid rgba(220, 132, 255, .25);
+  border-radius: 999px;
+  padding: .35rem .62rem;
+  color: #e9c8ff;
+  background: linear-gradient(100deg, rgba(168, 69, 255, .09), rgba(255, 79, 200, .07));
+  font-size: 10px;
+  font-weight: 600;
+  letter-spacing: .04em;
+  transition: border-color .18s ease, background .18s ease, box-shadow .18s ease, transform .18s ease;
+}
+.order-manual-bridge:hover { border-color: rgba(255, 104, 215, .62); color: #fff4ff; background: rgba(255, 74, 194, .14); box-shadow: 0 0 17px rgba(210, 69, 255, .16); transform: translateY(-1px); }
+.order-manual-bridge:focus-visible,
+.manual-primary-link:focus-visible { outline: 2px solid #ff7cd8; outline-offset: 3px; }
+
+/* System Manual: turn the data map into a readable cosmic atlas. */
+.system-manual {
+  position: relative;
+  isolation: isolate;
+  background-color: #08040f !important;
+  background-image: radial-gradient(ellipse at 16% 0%, rgba(164, 62, 255, .13), transparent 34rem), radial-gradient(ellipse at 90% 16%, rgba(255, 67, 192, .10), transparent 31rem) !important;
+}
+.system-manual-backdrop {
+  opacity: .78 !important;
+  background-image: radial-gradient(circle at 16% 8%, rgba(171, 70, 255, .15), transparent 29rem), radial-gradient(circle at 88% 18%, rgba(255, 70, 199, .10), transparent 28rem), linear-gradient(rgba(197, 118, 255, .026) 1px, transparent 1px), linear-gradient(90deg, rgba(197, 118, 255, .026) 1px, transparent 1px) !important;
+  background-size: auto, auto, 34px 34px, 34px 34px !important;
+}
+.system-manual-content { position: relative; z-index: 1; }
+.system-manual-hero {
+  isolation: isolate;
+  border-color: rgba(255, 86, 203, .36) !important;
+  background: radial-gradient(ellipse at 82% 0%, rgba(176, 81, 255, .19), transparent 38%), linear-gradient(118deg, rgba(31, 9, 48, .97), rgba(13, 6, 24, .96) 60%, rgba(39, 8, 38, .93)) !important;
+  box-shadow: 0 0 0 1px rgba(255, 85, 205, .06), 0 0 28px rgba(174, 65, 255, .16), 0 20px 55px rgba(0, 0, 0, .3), inset 0 0 38px rgba(219, 76, 238, .065) !important;
+}
+.system-manual-hero::after {
+  content: "";
+  position: absolute;
+  right: 8%;
+  bottom: 0;
+  left: 8%;
+  height: 1px;
+  pointer-events: none;
+  background: linear-gradient(90deg, transparent, #ff58cb, #ad67ff, transparent);
+  box-shadow: 0 0 16px rgba(255, 83, 204, .75);
+  animation: manual-warp-glint 7s ease-in-out infinite;
+}
+.system-manual-hero-art {
+  position: absolute;
+  top: 50%;
+  right: 3%;
+  width: clamp(190px, 25vw, 310px);
+  aspect-ratio: 1;
+  pointer-events: none;
+  opacity: .72;
+  transform: translateY(-50%);
+}
+.manual-orbit {
+  position: absolute;
+  inset: 8%;
+  border: 1px solid rgba(255, 99, 214, .42);
+  border-radius: 50%;
+  box-shadow: 0 0 22px rgba(226, 74, 255, .08), inset 0 0 24px rgba(183, 80, 255, .06);
+}
+.manual-orbit-one { transform: rotate(-22deg) scaleY(.72); }
+.manual-orbit-one::after {
+  content: "";
+  position: absolute;
+  inset: 16% -12%;
+  border: 1px solid rgba(182, 108, 255, .35);
+  border-radius: 50%;
+  transform: rotate(53deg);
+}
+.manual-orbit-two { inset: 20%; border-color: rgba(185, 110, 255, .30); transform: rotate(44deg) scaleY(.76); }
+.manual-planet {
+  position: absolute;
+  top: 37%;
+  left: 40%;
+  width: 21%;
+  aspect-ratio: 1;
+  border-radius: 50%;
+  background: radial-gradient(circle at 32% 27%, #fff1ff 0 4%, #ff87dd 13%, #a951ff 48%, #29103d 76%, #0b0412 100%);
+  box-shadow: 0 0 17px rgba(255, 99, 218, .75), 0 0 54px rgba(159, 69, 255, .52);
+  animation: manual-planet-float 5.5s ease-in-out infinite;
+}
+.manual-planet::after {
+  content: "";
+  position: absolute;
+  inset: 26% -45%;
+  border: 1px solid rgba(255, 155, 228, .65);
+  border-radius: 50%;
+  box-shadow: 0 0 11px rgba(255, 88, 206, .28);
+  transform: rotate(-24deg);
+}
+.manual-kicker { color: #f2a6e8 !important; text-shadow: 0 0 16px rgba(255, 76, 197, .2); }
+.manual-title { max-width: 18ch; text-shadow: 0 0 18px rgba(255, 78, 198, .20), 0 0 40px rgba(166, 91, 255, .14); }
+.manual-primary-link {
+  display: inline-flex;
+  align-items: center;
+  gap: .55rem;
+  border: 1px solid rgba(255, 145, 223, .42);
+  border-radius: .85rem;
+  padding: .7rem .95rem;
+  color: #fff4ff;
+  background: linear-gradient(105deg, #8e45e8, #d83db9 66%, #a84aff);
+  box-shadow: 0 0 18px rgba(230, 68, 205, .24), inset 0 0 14px rgba(255, 255, 255, .08);
+  font-size: .78rem;
+  font-weight: 700;
+  transition: transform .18s ease, box-shadow .18s ease, filter .18s ease;
+}
+.manual-primary-link:hover { filter: brightness(1.13); transform: translateY(-2px); box-shadow: 0 0 28px rgba(231, 67, 205, .38), 0 0 40px rgba(160, 75, 255, .18); }
+.manual-route-note { color: rgba(226, 194, 239, .48); font: 600 9px/1.5 'IBM Plex Mono', monospace; letter-spacing: .13em; }
+.system-manual-content > section[class*="rounded-[2rem]"] {
+  border-color: rgba(191, 113, 255, .20) !important;
+  background: radial-gradient(ellipse at 90% 0%, rgba(171, 64, 255, .07), transparent 34%), linear-gradient(145deg, rgba(19, 8, 31, .93), rgba(9, 6, 18, .93)) !important;
+  box-shadow: 0 16px 42px rgba(0, 0, 0, .21), inset 0 0 28px rgba(175, 71, 255, .035) !important;
+}
+.system-manual-content > section[class*="rounded-[2rem]"] > * { position: relative; z-index: 1; }
+.system-manual [class*="border-cyan-"],
+.system-manual [class*="border-emerald-"],
+.system-manual [class*="border-amber-"] { border-color: rgba(195, 116, 255, .24) !important; }
+.system-manual [class*="text-cyan-"] { color: #e6adf3 !important; }
+.system-manual [class*="text-emerald-"] { color: #d9b0ff !important; }
+.system-manual [class*="text-amber-"] { color: #ffb9e5 !important; }
+.system-manual [class*="bg-cyan-"],
+.system-manual [class*="bg-emerald-"],
+.system-manual [class*="bg-amber-"] { background-color: rgba(170, 70, 255, .075) !important; }
+.system-manual [class*="shadow-cyan-"],
+.system-manual [class*="shadow-emerald-"],
+.system-manual [class*="shadow-amber-"] { --tw-shadow-color: rgba(177, 70, 255, .14) !important; }
+.system-manual [class*="from-cyan-"],
+.system-manual [class*="from-emerald-"],
+.system-manual [class*="from-amber-"] { --tw-gradient-from: #c65de4 !important; --tw-gradient-to: rgb(198 93 228 / 0) !important; }
+.system-manual [class*="via-cyan-"],
+.system-manual [class*="via-emerald-"],
+.system-manual [class*="via-amber-"] { --tw-gradient-via: #b26aff !important; }
+.system-manual [class*="to-cyan-"],
+.system-manual [class*="to-emerald-"],
+.system-manual [class*="to-amber-"] { --tw-gradient-to: #a45bf2 !important; }
+.system-manual [class*="border-white/10"] { border-color: rgba(197, 144, 255, .15) !important; }
+.system-manual [class*="bg-white/"] { background-color: rgba(180, 88, 255, .045) !important; }
+.system-manual [class*="hover:border-cyan-"]:hover { border-color: rgba(255, 102, 214, .48) !important; }
+.system-manual [class*="hover:bg-cyan-"]:hover { background-color: rgba(255, 73, 198, .10) !important; }
+
+@keyframes manual-planet-float { 0%, 100% { transform: translateY(0) rotate(-4deg); } 50% { transform: translateY(7px) rotate(4deg); } }
+@keyframes manual-warp-glint { 0%, 100% { opacity: .55; filter: brightness(.9); } 50% { opacity: 1; filter: brightness(1.25); } }
+@media (max-width: 767px) {
+  .system-manual-hero-art { top: 5%; right: -13%; width: 190px; opacity: .38; transform: none; }
+  .manual-title { max-width: 16ch; }
+  .manual-primary-link { width: 100%; justify-content: center; }
+  .manual-route-note { width: 100%; text-align: center; }
+}
+@media (prefers-reduced-motion: reduce) {
+  .system-manual-hero::after, .manual-planet { animation: none !important; }
+  .manual-primary-link, .order-manual-bridge { transition: none; }
+}
