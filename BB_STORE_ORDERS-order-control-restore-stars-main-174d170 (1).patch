+.order-control-room .central-clock-date { color: #c8bdff; text-shadow: 0 0 8px rgba(167, 139, 250, .24); }
+.order-control-room .signal-ticker { border-color: rgba(103, 232, 249, .14); color: rgba(167, 232, 242, .58); }
+.order-control-room .live-chip { border-color: rgba(103, 232, 249, .34); color: #c5faff; background: rgba(34, 211, 238, .055); }
+.order-control-room .live-dot { background: #67e8f9; box-shadow: 0 0 10px rgba(103, 232, 249, .78); }
+.order-control-room .signal-metric {
