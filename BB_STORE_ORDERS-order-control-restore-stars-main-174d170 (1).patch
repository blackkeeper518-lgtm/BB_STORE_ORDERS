+  box-shadow: 0 0 14px rgba(103, 232, 249, .14), 0 0 34px rgba(130, 86, 230, .08), inset 0 0 26px rgba(103, 232, 249, .045);
+}
+.order-control-room .central-clock-label { color: #78e7f5; text-shadow: 0 0 8px rgba(103, 232, 249, .38); }
