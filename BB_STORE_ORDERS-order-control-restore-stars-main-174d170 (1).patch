+
+/* DARKSIDE COSMIC SUITE · shared visual language for Orders + System Manual */
+:root {
+  --darkside-deep: #08040f;
+  --darkside-panel: #13091f;
+  --darkside-violet: #ad5cff;
+  --darkside-magenta: #ff4fc8;
+  --darkside-lilac: #f0d8ff;
+}
+
+.singto-cyber-edge::before {
+  background: linear-gradient(90deg, transparent, rgba(255, 76, 197, .88), rgba(170, 83, 255, .92), rgba(255, 76, 197, .88), transparent) border-box;
+}
+.singto-cyber-edge::after {
+  background: repeating-linear-gradient(0deg, transparent 0, transparent 3px, rgba(226, 94, 239, .035) 4px);
+}
+.singto-cyber-edge [data-active="true"] {
+  background: linear-gradient(90deg, rgba(255, 72, 199, .17), rgba(151, 77, 255, .13)) !important;
+  box-shadow: inset 2px 0 #ff53cb, 0 0 18px rgba(190, 67, 255, .13) !important;
+}
+
+/* Orders: deep-space black, violet identity, restrained pink and crisp cyan signals. */
