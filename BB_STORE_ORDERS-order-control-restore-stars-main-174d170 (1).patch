+.order-control-room .cyber-title { text-shadow: 0 0 15px rgba(133, 102, 255, .20), 0 0 28px rgba(103, 232, 249, .08); }
+.order-control-room .orbit-kicker { color: #a9dce9; }
+.order-control-room .central-clock {
+  border-color: rgba(103, 232, 249, .38);
+  background: linear-gradient(145deg, rgba(5, 13, 19, .98), rgba(10, 7, 20, .97));
