+function formatCod(value: ParcelRow["cod_amount"]) {
+  if (value == null || String(value).trim() === "") return "ไม่ระบุ";
+  const amount = Number(String(value).replace(/[^0-9.-]/g, ""));
+  return Number.isFinite(amount) ? money.format(amount) : String(value);
+}
+
