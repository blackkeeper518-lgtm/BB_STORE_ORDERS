+
+/* System Manual: turn the data map into a readable cosmic atlas. */
+.system-manual {
+  position: relative;
+  isolation: isolate;
+  background-color: #08040f !important;
+  background-image: radial-gradient(ellipse at 16% 0%, rgba(164, 62, 255, .13), transparent 34rem), radial-gradient(ellipse at 90% 16%, rgba(255, 67, 192, .10), transparent 31rem) !important;
+}
+.system-manual-backdrop {
