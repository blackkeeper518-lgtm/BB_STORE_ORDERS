+  background-image: radial-gradient(circle at 16% 8%, rgba(171, 70, 255, .15), transparent 29rem), radial-gradient(circle at 88% 18%, rgba(255, 70, 199, .10), transparent 28rem), linear-gradient(rgba(197, 118, 255, .026) 1px, transparent 1px), linear-gradient(90deg, rgba(197, 118, 255, .026) 1px, transparent 1px) !important;
