+type LookupState = "idle" | "loading" | "found" | "missing" | "error";
+
+function LookupStatusCard({ source, state, summary, detail }: {
+  source: string;
+  state: LookupState;
+  summary: string;
+  detail: string;
+}) {
+  const styles: Record<LookupState, string> = {
+    idle: "border-violet-300/15 bg-violet-400/[0.035] text-violet-100/70",
+    loading: "border-cyan-300/25 bg-cyan-400/[0.05] text-cyan-100",
+    found: "border-emerald-300/25 bg-emerald-400/[0.05] text-emerald-100",
+    missing: "border-amber-300/20 bg-amber-400/[0.045] text-amber-100",
+    error: "border-pink-300/25 bg-pink-400/[0.05] text-pink-100",
+  };
+  const labels: Record<LookupState, string> = {
+    idle: "รอค้น",
+    loading: "กำลังค้น",
+    found: "พบ",
+    missing: "ไม่พบ",
+    error: "อ่านไม่ได้",
+  };
+  return (
+    <div className={`min-w-0 rounded-xl border px-2.5 py-2 ${styles[state]}`}>
+      <div className="flex min-w-0 items-center justify-between gap-1">
+        <span className="truncate text-[9px] font-bold uppercase tracking-[0.12em]">{source}</span>
+        <span className="shrink-0 rounded-md border border-current/20 px-1 py-0.5 text-[8px] font-semibold">{labels[state]}</span>
+      </div>
+      <p className="mt-1 break-words text-[10px] font-semibold leading-4 text-white">{summary}</p>
+      <p className="mt-0.5 line-clamp-2 break-words text-[9px] leading-3.5 opacity-70">{detail}</p>
+    </div>
+  );
+}
