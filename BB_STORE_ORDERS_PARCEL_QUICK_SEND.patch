+export async function getParcelRowsByPhone(phone: string) {
+  const inputDigits = String(phone ?? "").replace(/\D/g, "");
+  const normalizedPhone = inputDigits.startsWith("66") ? `0${inputDigits.slice(2)}` : inputDigits;
+  if (normalizedPhone.length !== 10) throw new Error("กรุณากรอกเบอร์โทรศัพท์ 10 หลัก");
+  const params = new URLSearchParams({
+    select: "id,pickup_date,consignee,phone_number,tracking_number,cod_amount",
+    phone_number: `eq.${normalizedPhone}`,
+    order: "pickup_date.desc.nullslast,id.desc",
+    limit: "100",
+  });
+  return supabaseGet<Array<Record<string, unknown>>>(`parcels?${params.toString()}`);
+}
