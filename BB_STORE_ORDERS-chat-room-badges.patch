an-300/10 bg-cyan-300/[0.04]"}`}><div className="flex items-center justify-between gap-2"><p className="text-[10px] font-semibold uppercase tracking-[0.18em] text-cyan-100/65">COD SIGNAL DECK</p><span className={`h-2.5 w-2.5 rounded-full ${selected.codTodayActive ? "bg-fuchsia-100 shadow-[0_0_14px_rgba(255,255,255,.95)]" : "bg-cyan-100/20"}`} /></div><p className={`mt-2 text-sm font-semibold ${selected.codTodayActive ? "text-fuchsia-50" : "text-cyan-100/65"}`}>{selected.codTodayActive ? "COD วันนี้ · มีออเดอร์แล้ว" : "ยังไม่มี COD วันนี้"}</p><div className="mt-2 grid grid-cols-2 gap-2 text-[10px]"><span className="rounded-lg bg-black/20 p-2 text-cyan-100/55">COD signal <b className="ml-1 text-cyan-100">{selected.codSignalCount ?? 0}</b></span><span className="rounded-lg bg-black/20 p-2 text-cyan-100/55">COD วันนี้ <b className="ml-1 text-cyan-100">{selected.todayCodSignalCount ?? 0}</b></span></div></div>{selectedTrackingRows.length ? selectedTrackingRows.map((row, index) => <div key={`${row.tracking_number}-${index}`} className="rounded-xl border border-emerald-300/15 bg-emerald-300/[0.04] p-3"><div className="flex items-center justify-between gap-2"><p className="font-mono text-sm font-bold text-emerald-100">{row.tracking_number || "ไม่มีเลข"}</p><span className="text-[10px] text-emerald-200/65">สำรอง</span></div><p className="mt-1 truncate text-[10px] text-cyan-100/45">{row.order_number_display || row.order_number || "ไม่พบออเดอร์"} · {row.shipping_carrier || "FLASH EXPRESS"}</p><div className="mt-3 grid gap-2"><Button type="button" size="sm" onClick={() => setReplyText(String(row.facebook_tracking_message || ""))} disabled={!row.facebook_tracking_message} className="h-8 justify-start bg-emerald-500/15 text-[10px] text-emerald-100 hover:bg-emerald-500/25">เสียบ Facebook ลงกล่อง</Button><Button type="button" size="sm" variant="outline" onClick={() => setReplyText(String(row.drakside_tracking_message || ""))} disabled={!row.drakside_tracking_message} className="h-8 justify-start border-cyan-300/20 text-[10px] text-cyan-100">เสียบ Drakside ลงกล่อง</Button></div><p className="mt-2 text-[9px] leading-4 text-cyan-100/35">กดแล้วแค่ใส่ในช่องพิมพ์ ยังไม่ส่งให้ลูกค้า</p></div>) : <div className="rounded-xl border border-cyan-300/10 bg-black/20 p-3 text-xs leading-5 text-cyan-100/45">ห้องนี้ยังไม่มี Tracking สำรอง</div>}</> : <div className="p-4 text-center text-xs text-cyan-100/40">เลือกห้องแชทก่อน</div>}</CardContent></Card>
